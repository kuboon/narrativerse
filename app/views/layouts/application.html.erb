<!DOCTYPE html>
<html data-theme="autumn">
  <head>
    <title><%= content_for(:title) || "ナラティバース" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <%= link_to "Narrativerse", root_path, class: "logo" %>
        <nav>
          <%= link_to "プロット", plots_path, class: "nav-link" %>
          <%= link_to "要素", elements_path, class: "nav-link" %>
        </nav>
        <div class="nav-actions">
          <% if current_user %>
            <span class="user-pill"><%= current_user.name %> としてログイン中</span>
            <%= button_to "ログアウト", session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
          <% else %>
            <%= link_to "ログイン", new_session_path, class: "btn btn-ghost btn-sm" %>
            <%= link_to "ユーザー作成", new_user_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      </div>
      <%= yield :site_header_extra %>
    </header>

    <% if flash[:notice].present? %>
      <div class="flash">
        <p><%= flash[:notice] %></p>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="flash error">
        <p><%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= yield %>

    <% if current_user && controller_name != "reader" %>
      <% chat_params = {} %>
      <% if params[:plot_id].present? %>
        <% chat_params[:plot_id] = params[:plot_id] %>
      <% elsif controller_name == "plots" && params[:id].present? %>
        <% chat_params[:plot_id] = params[:id] %>
      <% end %>
      <% chat_params[:scene_id] = params[:scene_id] if params[:scene_id].present? %>

      <div id="chatbot-wrapper" class="fixed bottom-5 right-5 z-50 flex flex-col items-end">
        <div id="chatbot-window" class="mb-4 hidden h-125 max-h-[calc(100vh-100px)] w-87.5 overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-2xl">
          <iframe src="<%= chat_path(chat_params) %>" id="chat-frame" class="h-full w-full border-0"></iframe>
        </div>
        <button id="chatbot-toggle" class="btn btn-primary btn-circle h-14 w-14 text-xl shadow-lg" aria-label="AIアシスタントを開く">AI</button>
      </div>
    <% end %>
  </body>
</html>
