<% own = policy(plot_scene_link.plot).own?
  scene = plot_scene_link.scene
  scene_html = sanitize(scene.text.presence || "シーンを書く", tags: %w[p strong h1 h2 ruby rt])
  editor_data = {
    controller: "inline-prosemirror",
    inline_prosemirror_url_value: plot_scene_link_path(plot_scene_link),
    inline_prosemirror_param_value: "scene[text]",
    inline_prosemirror_method_value: "patch",
    inline_prosemirror_placeholder_value: "シーンを書く",
    inline_prosemirror_initial_html_value: scene_html
  } %>

<div id="<%= dom_id(plot_scene_link) %>" data-own="<%= own %>">
  <% if own %>
    <%= tag.article(scene_html, id: dom_id(scene), class: "scene-container scene-display", data: editor_data) %>
  <% else %>
    <%= tag.article(scene_html, id: dom_id(scene), class: "scene-container scene-display") %>
  <% end %>
</div>
