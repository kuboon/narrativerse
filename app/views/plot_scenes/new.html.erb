<main class="page">
  <section class="form-card">
    <h1>ストーリーに追加</h1>
    <p class="lede">ストーリーは内部で生成されます。次の物語をここに書いてください。</p>
    <%= form_with model: @scene, url: plot_plot_scenes_path(@plot) do |form| %>
      <div class="field">
        <%= form.label :text, "次のストーリー" %>
        <div class="prosemirror-editor-container" data-controller="prosemirror">
          <div class="prosemirror-toolbar mb-2 flex gap-2" data-prosemirror-target="toolbar">
            <button type="button" class="px-2 py-1 border rounded" data-action="click->prosemirror#toggleBold" data-mark="strong">太字</button>
            <button type="button" class="px-2 py-1 border rounded" data-action="click->prosemirror#setRuby" data-mark="ruby">ルビ</button>
          </div>
          <%= form.hidden_field :text, class: "prosemirror-hidden-input scene-textarea" %>
          <div class="prosemirror-editor w-full p-2 border rounded min-h-[100px]" data-prosemirror-target="editor"></div>
        </div>
      </div>
      <div class="actions">
        <%= form.submit "追加", class: "btn primary" %>
        <%= link_to "キャンセル", plot_path(@plot), class: "btn ghost" %>
      </div>
    <% end %>
  </section>
</main>