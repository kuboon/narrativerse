<%= form_with(model: message, url: chat_messages_path, id: "new_message") do |form| %>
  <div style="display: flex; gap: 8px;">
    <%= form.text_field :content, style: "flex: 1; border-radius: 20px; border: 1px solid var(--border); padding: 8px 12px; outline: none;", placeholder: "Type a message...", autocomplete: "off" %>
    <%= form.submit "Send", class: "btn primary", style: "padding: 6px 16px; min-width: auto; font-size: 14px;" %>
  </div>
<% end %>