<% speaker_name = message.role == "user" ? "あなた" : "AI" %>
<% placement = message.role == "user" ? "chat-end" : "chat-start" %>
<% bubble_color = message.role == "user" ? "" : "chat-bubble-neutral" %>
<% message_kind = message.thinking_message? ? "thinking" : "default" %>

<div id="message_<%= message.id %>" class="chat <%= placement %>" data-message-kind="<%= message_kind %>">
  <div class="chat-header text-xs font-semibold text-base-content/70">
    <%= speaker_name %>
    <time class="ml-2 text-[11px] font-normal text-base-content/50"><%= message.created_at&.strftime("%I:%M %p") %></time>
  </div>

  <% if message.thinking_message? %>
    <%
      status_label = if message.tool_call?
                       "アクションを実行中"
                     elsif message.tool_result?
                       "アクション完了"
                     elsif message.role == "system"
                       "システム設定"
                     else
                       "考え中"
                     end

      tool_names = if message.tool_call?
                     message.tool_calls.map { |tc| tool_name_label(tc.name) }.join(", ")
                   elsif message.tool_result?
                     tool_name_label(message.parent_tool_call&.name)
                   end
    %>

    <div class="chat-bubble chat-bubble-neutral max-w-[85%] p-0 overflow-hidden text-[11px] text-base-content/70">
      <details class="group">
        <summary class="flex items-center gap-2 p-2 px-3 cursor-pointer list-none hover:bg-base-content/5 transition-colors">
          <% if message.tool_call? %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 animate-spin" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
            </svg>
          <% elsif message.tool_result? %>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-success" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          <% end %>

          <span class="font-bold"><%= status_label %></span>
          <% if tool_names.present? %>
            <span class="opacity-60 ml-1">: <%= tool_names %></span>
          <% end %>

          <span class="loading loading-dots loading-xs group-open:hidden ml-auto" aria-hidden="true"></span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-auto transition-transform group-open:rotate-180 opacity-50" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </summary>
        <div class="px-3 pb-3 pt-1 space-y-3 border-t border-base-content/5 bg-base-100/20">
          <% if message.thinking_text.present? %>
            <div class="whitespace-pre-wrap font-serif italic opacity-80 leading-relaxed"><%= message.thinking_text %></div>
          <% end %>

          <% if message.tool_calls.any? %>
            <div class="space-y-2">
              <% message.tool_calls.each do |tool_call| %>
                <div class="p-2 rounded bg-base-300/40 font-mono text-[10px] border border-base-content/5">
                  <div class="font-bold text-primary/70">Tool: <%= tool_call.name %></div>
                  <div class="mt-1 opacity-70 break-all overflow-x-auto"><%= tool_call.arguments.to_json %></div>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if message.tool_result? %>
             <div class="p-2 rounded bg-base-300/40 font-mono text-[10px] border border-base-content/5">
               <div class="font-bold text-secondary/70">Result:</div>
               <div class="mt-1 opacity-70 break-all overflow-x-auto"><%= message.content %></div>
             </div>
          <% end %>

          <% if message.role == "system" %>
             <div class="p-2 rounded bg-base-300/40 font-mono text-[10px] border border-base-content/5">
               <div class="font-bold text-base-content/40">System Context:</div>
               <div class="mt-1 opacity-60 break-all overflow-x-auto"><%= message.content %></div>
             </div>
          <% end %>
        </div>
      </details>
    </div>
    <% if message.role == "assistant" && message.content.present? && !message.tool_call? %>
      <div id="message_<%= message.id %>_content" class="chat-bubble <%= bubble_color %> max-w-[85%] whitespace-pre-wrap text-sm leading-relaxed mt-1"><%= message.content %></div>
    <% end %>
  <% elsif (choice_payload = message.choice_payload) %>
    <div class="chat-bubble chat-bubble-neutral max-w-[85%]">
      <%= render "messages/choice_buttons", payload: choice_payload %>
    </div>
  <% else %>
    <div id="message_<%= message.id %>_content" class="chat-bubble <%= bubble_color %> max-w-[85%] whitespace-pre-wrap text-sm leading-relaxed"><%= message.content %></div>
  <% end %>
</div>