<div class="space-y-3">
  <p class="text-sm leading-relaxed"><%= payload["question"] %></p>
  <div class="flex flex-col gap-2">
    <% payload["choices"].each do |choice| %>
      <button type="button" class="chat-choice" data-choice="<%= choice %>">
        <%= choice %>
      </button>
    <% end %>
  </div>
</div>
