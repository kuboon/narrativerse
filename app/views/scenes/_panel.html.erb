<article id="link-<%= link.id %>" class="scene-container" data-link-id="<%= link.id %>" data-scene-id="<%= link.scene.id %>">
  <% owner = link.plot.user_id == current_user&.id %>
  <div class="scene-display <%= 'cursor-pointer hover:bg-gray-50' if owner %>">
    <% if link.scene.text.present? %>
      <%= sanitize(link.scene.text, tags: %w[p strong h1 h2 ruby rt]) %>
    <% else %>
      （テキストを入力してください）
    <% end %>
  </div>

  <% if owner %>
    <div class="scene-editor hidden">
      <%= form_with model: link.scene, url: plot_scene_path(link), method: :patch, class: "scene-form w-full", html: { data: { turbo: true } } do |f| %>
        <div class="prosemirror-editor-container" data-controller="prosemirror">
          <%= f.hidden_field :text, class: "prosemirror-hidden-input scene-textarea" %>
          <div class="prosemirror-editor w-full p-2 border rounded min-h-25" data-prosemirror-target="editor"></div>
        </div>
      <% end %>
    </div>
  <% end %>
</article>
