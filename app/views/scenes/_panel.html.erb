<% owner = link.plot.user_id == current_user&.id %>
<article id="<%= dom_id(link) %>" 
         class="scene-container <%= "highlight-new" if local_assigns[:highlight] %>" 
         data-link-id="<%= link.id %>" 
         data-scene-id="<%= link.scene.id %>"
         <%= 'data-controller="inline-editor"' if owner %>
         <%= 'data-action="click->inline-editor#edit window:inline-editor:close-others->inline-editor#closeOthers click@window->inline-editor#clickOutside keydown@window->inline-editor#onKeyDown"' if owner %>
         data-inline-editor-editing-class="border-editing"
         data-inline-editor-saving-class="border-saving"
         data-inline-editor-saved-class="border-saved">
  <div class="scene-display <%= 'cursor-pointer hover:bg-gray-50' if owner %>" <%= 'data-inline-editor-target="display"' if owner %>>
    <% if link.scene.text.present? %>
      <%= sanitize(link.scene.text, tags: %w[p strong h1 h2 ruby rt]) %>
    <% else %>
      （テキストを入力してください）
    <% end %>
  </div>

  <% if owner %>
    <div class="scene-editor hidden" data-inline-editor-target="editor">
      <%= form_with model: link.scene, url: plot_scene_path(link), method: :patch, class: "scene-form w-full", html: { data: { turbo: true, inline_editor_target: "form" } } do |f| %>
        <div class="prosemirror-editor-container" data-controller="prosemirror" data-action="input->inline-editor#onInput">
          <%= f.hidden_field :text, class: "prosemirror-hidden-input scene-textarea", data: { inline_editor_target: "input" } %>
          <div class="prosemirror-editor w-full p-2 border rounded min-h-25" data-prosemirror-target="editor"></div>
        </div>
      <% end %>
    </div>
  <% end %>
</article>
