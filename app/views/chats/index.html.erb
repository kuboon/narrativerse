<% content_for :title, "Chats" %>

<main class="page">
  <section class="grid">
    <div class="grid-header">
      <h1>Chats</h1>
      <%= link_to "New chat", new_chat_path, class: "btn btn-primary" %>
    </div>

    <div id="chats" class="cards">
      <% @chats.each do |chat| %>
        <article class="card">
          <%= render chat %>
          <div class="card-actions">
            <%= link_to "Show this chat", chat, class: "text-link" %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
</main>