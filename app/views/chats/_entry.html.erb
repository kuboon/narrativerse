<%# Renders one Entry value object from MessagePresenter.
    entry is one of: MessagePresenter::ActionItem, ThinkingEntry, RegularEntry, ChoiceEntry %>
<% case entry %>
<% in MessagePresenter::ActionItem => action %>
  <div id="action_entry_<%= action.lead_message_id %>"
       class="my-0.5 px-1"
       data-message-kind="action">
    <details class="group">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-3 py-1.5 text-xs text-base-content/50 transition-colors hover:bg-base-200 hover:text-base-content/70">
        <% if action.done %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-success/70" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        <% else %>
          <span class="loading loading-spinner loading-xs shrink-0 opacity-60"></span>
        <% end %>
        <span><%= action.status_label %></span>
        <% if action.detail_label.present? %>
          <span class="opacity-60">— <%= action.detail_label %></span>
        <% end %>
        <svg xmlns="http://www.w3.org/2000/svg" class="ml-auto h-3 w-3 shrink-0 opacity-40 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </summary>
      <% if action.execution_text.present? %>
        <div class="mx-3 mt-1 mb-2 rounded-md bg-base-200 px-3 py-2 font-mono text-[10px] leading-relaxed text-base-content/60">
          <%= action.execution_text %>
        </div>
      <% end %>
    </details>
  </div>

<% in MessagePresenter::ThinkingEntry => thinking %>
  <div id="thinking_group_<%= thinking.lead_message_id %>"
       class="my-0.5 px-1"
       data-message-kind="thinking">
    <details class="group">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-3 py-1.5 text-xs text-base-content/50 transition-colors hover:bg-base-200 hover:text-base-content/70">
        <% if thinking.done %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-success/70" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        <% else %>
          <span class="loading loading-spinner loading-xs shrink-0 opacity-60"></span>
        <% end %>
        <span><%= thinking.status_label %></span>
        <span class="loading loading-dots loading-xs opacity-40 group-open:hidden" aria-hidden="true"></span>
        <svg xmlns="http://www.w3.org/2000/svg" class="ml-auto h-3 w-3 shrink-0 opacity-40 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </summary>
      <% if thinking.thinking_text.present? %>
        <div class="mx-3 mt-1 mb-2 rounded-md bg-base-200 px-3 py-2 text-[11px] leading-relaxed text-base-content/60 italic">
          <%= thinking.thinking_text.truncate(320) %>
        </div>
      <% end %>
    </details>
  </div>

<% in MessagePresenter::ChoiceEntry => choice %>
  <div id="message_<%= choice.message.id %>"
       class="chat chat-start my-2"
       data-message-kind="choice">
    <div class="chat-image avatar placeholder">
      <div class="w-8 rounded-full bg-neutral text-neutral-content text-[10px]">
        <span>AI</span>
      </div>
    </div>
    <div class="chat-bubble chat-bubble-neutral max-w-[88%]">
      <%= render "messages/choice_buttons", payload: choice.payload %>
    </div>
    <div class="chat-footer mt-1 text-xs opacity-40">
      <%= choice.message.created_at&.strftime("%H:%M") %>
    </div>
  </div>

<% in MessagePresenter::RegularEntry => regular %>
  <% is_user = regular.message.role == "user" %>
  <div id="message_<%= regular.message.id %>"
       class="chat <%= is_user ? "chat-end" : "chat-start" %> my-2"
       data-message-kind="default">
    <% unless is_user %>
      <div class="chat-image avatar placeholder">
        <div class="w-8 rounded-full bg-neutral text-neutral-content text-[10px]">
          <span>AI</span>
        </div>
      </div>
    <% end %>
    <div id="message_<%= regular.message.id %>_content"
         class="chat-bubble <%= is_user ? "chat-bubble-primary" : "chat-bubble-neutral" %> max-w-[88%] text-sm leading-relaxed">
      <%= regular.message.content %>
    </div>
    <div class="chat-footer mt-1 text-xs opacity-40">
      <%= regular.message.created_at&.strftime("%H:%M") %>
    </div>
  </div>

<% end %>
