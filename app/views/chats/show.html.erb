<!DOCTYPE html>
<html data-theme="autumn">
<head>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
</head>
<body class="m-0 flex min-h-screen flex-col bg-base-100"
      data-controller="chatbot"
      data-action="click->chatbot#selectChoice">
  <%= turbo_stream_from "chat_#{@chat.id}" %>

  <header class="sticky top-0 z-10 flex items-center justify-between border-b border-base-300 bg-base-200/95 px-4 py-2.5 backdrop-blur">
    <div class="flex items-center gap-2">
      <div class="avatar placeholder">
        <div class="w-7 rounded-full bg-neutral text-neutral-content text-[10px]">
          <span>AI</span>
        </div>
      </div>
      <span class="text-sm font-semibold">AI アシスタント</span>
    </div>
    <button class="btn btn-ghost btn-xs btn-circle"
            aria-label="閉じる"
            onclick="window.parent.postMessage('close-chat', '*')">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
  </header>

  <div id="messages"
       data-chatbot-target="messages"
       class="flex flex-1 flex-col overflow-y-auto px-3 py-4">
    <% MessagePresenter.new(@chat.messages).entries.each do |entry| %>
      <%= render "chats/entry", entry: entry %>
    <% end %>
  </div>

  <div class="sticky bottom-0 border-t border-base-300 bg-base-100 px-4 py-3">
    <%= render "messages/form", chat: @chat, message: @message, plot_id: @plot_id, scene_id: @scene_id %>
  </div>
</body>
</html>
