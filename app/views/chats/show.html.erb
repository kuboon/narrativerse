<!DOCTYPE html>
<html data-theme="autumn">
<head>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
</head>
<body class="m-0 flex min-h-screen flex-col bg-base-100">
  <%= turbo_stream_from "chat_#{@chat.id}" %>

  <div class="chatbox-header">
    <h3 class="m-0 text-sm font-semibold">AI アシスタント</h3>
    <button id="close-chat-btn" class="btn btn-ghost btn-xs btn-circle" aria-label="閉じる">✕</button>
  </div>

  <div id="messages" class="flex flex-1 flex-col gap-3 overflow-y-auto bg-base-100 p-4">
    <% @chat.messages.where.not(id: nil).each do |message| %>
      <%= render message %>
    <% end %>
  </div>

  <div class="border-t border-base-300 bg-base-200 p-3">
    <%= render "messages/form", chat: @chat, message: @message, plot_id: @plot_id, scene_id: @scene_id %>
  </div>

  <script>
    document.addEventListener("turbo:load", function() {
      const messages = document.getElementById("messages");
      if(messages) {
        messages.scrollTop = messages.scrollHeight;
      }
      
      const closeBtn = document.getElementById("close-chat-btn");
      if(closeBtn) {
        closeBtn.addEventListener("click", function() {
          window.parent.postMessage("close-chat", "*");
        });
      }
    });
  </script>
</body>
</html>