<div id="<%= dom_id chat %>">
  <div class="text-sm">
    <strong>Model:</strong>
    <%= chat.model&.name || 'Default' %>
  </div>

  <div class="text-sm">
    <strong>Messages:</strong>
    <%= chat.messages.count %>
  </div>

  <div class="text-sm text-base-content/70">
    <strong>Created:</strong>
    <%= chat.created_at.strftime("%B %d, %Y at %I:%M %p") %>
  </div>
</div>