<%= turbo_stream_from(@plot) %>

<main class="page">
  <%= render "plot", plot: @plot %>
</main>

<% if policy(@plot).own? %>
  <div id="chat-float">
    <button popovertarget="chat-popover" style="anchor-name:--chat-anchor">
      <div class="avatar avatar-online avatar-placeholder">
        <div class="bg-primary text-primary-content w-16 rounded-full">
          <span class="text-xl">AI</span>
        </div>
      </div>
    </button>

    <div
      class="dropdown dropdown-right dropdown-end"
      popover
      id="chat-popover"
      style="position-anchor:--chat-anchor"
    >
      <turbo-frame id="chat-frame" src="<%= chat_path %>" loading="lazy">
        loading..
      </turbo-frame>
    </div>
  </div>
<% end %>
