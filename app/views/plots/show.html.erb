<main class="page">
  <section class="detail">
    <%= render "overview", plot: @plot, story_links: @story_links %>

    <div class="detail-meta">
      <div>
        <span class="meta-label">作成者</span>
        <span><%= @plot.user.name %></span>
      </div>
      <div>
        <span class="meta-label">親プロット</span>
        <span>
          <% if @plot.parent_plots.any? %>
            <%= safe_join(@plot.parent_plots.map { |parent| link_to(render_plot_title(parent.title), plot_path(parent), class: "text-link") }, ", ") %>
          <% else %>
            なし
          <% end %>
        </span>
      </div>
    </div>

    <% if policy(@plot).manage_elements? %>
      <div class="detail-actions">
        <%= link_to "要素を追加", new_plot_plot_element_path(@plot), class: "btn btn-ghost" %>
      </div>
    <% end %>

    <% if @plot.plot_elements.any? %>
      <div class="grid">
        <div class="grid-header">
          <h2>登場要素</h2>
        </div>
        <div class="cards">
          <% @plot.plot_elements.includes(:element, :element_revision).each do |plot_element| %>
            <article class="card">
              <h3><%= plot_element.element.name %></h3>
              <p class="badge"><%= t("elements.types.#{plot_element.element.element_type.downcase}") %></p>
              <p><%= plot_element.summary.presence || plot_element.element_revision&.summary.presence || "まだ概要がありません。" %></p>
              <div class="card-actions">
                <%= link_to "詳細", element_path(plot_element.element), class: "text-link" %>
                <% if policy(@plot).manage_elements? %>
                  <%= link_to "編集", edit_plot_element_path(plot_element), class: "text-link" %>
                  <% if plot_element.element.latest_revision && plot_element.element.latest_revision.id != plot_element.element_revision_id %>
                    <%= button_to "更新する", refresh_revision_plot_plot_element_path(@plot, plot_element), method: :patch, class: "btn btn-ghost" %>
                  <% end %>
                  <%= button_to "削除", plot_element_path(plot_element), method: :delete, class: "btn btn-ghost" %>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="grid">
      <div class="grid-header">
        <h2>シーン</h2>
      </div>
      <div class="story-flow" id="story-flow">
        <% if @story_links.any? %>
          <% @story_links.each do |link| %>
            <%= render "scenes/panel", link: %>
          <% end %>
        <% else %>
          <div id="story-flow-empty" class="empty-state">
            <p>まだシーンがありません。最初のシーンを追加しましょう。</p>
          </div>
        <% end %>
      </div>
      <% if policy(@plot).manage_story? %>
        <div class="actions mt-4">
          <%= button_to @story_links.any? ? "シーンを追加" : "最初のシーンを追加", plot_plot_scenes_path(@plot, scene: { text: "新しいシーン" }), method: :post, form: { data: { turbo: true } }, class: "btn btn-primary w-full text-center" %>
        </div>
      <% end %>
    </div>
  </section>
</main>
