<main class="page">
  <%= turbo_stream_from @plot %>
  <section class="detail">
    <%= render "overview", plot: @plot, story_links: @story_links %>

    <div class="detail-meta">
      <div>
        <span class="meta-label">作成者</span>
        <span><%= @plot.user.name %></span>
      </div>
      <% parent_plots = @plot.parent_plots %>
      <% if parent_plots.any? %>
        <div>
          <span class="meta-label">親プロット</span>
          <span>
            <%= safe_join(parent_plots.map { |parent| link_to(render_plot_title(parent.title), plot_path(parent), class: "text-link") }, ", ") %>
          </span>
        </div>
      <% end %>
    </div>

    <% if @plot.plot_elements.any? %>
      <div class="grid">
        <div class="grid-header">
          <h2>登場要素</h2>
        </div>
        <div class="cards" id="plot-elements">
          <% @plot.plot_elements.includes(:element, :element_revision).each do |plot_element| %>
            <%= render "plot_elements/plot_element", plot_element: plot_element %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if policy(@plot).manage_elements? %>
      <div class="detail-actions">
        <%= link_to "要素を追加", new_plot_plot_element_path(@plot), class: "btn btn-ghost" %>
      </div>
    <% end %>

    <div class="grid">
      <div class="grid-header">
        <h2>シーン</h2>
      </div>
      <div class="story-flow" id="story-flow">
        <% if @story_links.any? %>
          <% @story_links.each do |link| %>
            <%= render "scenes/panel", link: %>
          <% end %>
        <% else %>
          <div id="story-flow-empty" class="empty-state">
            <p>まだシーンがありません。最初のシーンを追加しましょう。</p>
          </div>
        <% end %>
      </div>
      <% if policy(@plot).manage_story? %>
        <div class="actions mt-4">
          <%= button_to @story_links.any? ? "シーンを追加" : "最初のシーンを追加", plot_plot_scenes_path(@plot, scene: { text: "新しいシーン" }), method: :post, form: { data: { turbo: true } }, class: "btn btn-primary w-full text-center" %>
        </div>
      <% end %>
    </div>
  </section>
</main>
