<% content_for :site_header_extra do %>
  <div class="reader-site-header">
    <div class="container reader-site-header-content">
      <h1 class="reader-title"><%= @plot.title %></h1>
      <% if @story_links.any? %>
        <div class="reader-progress" data-reader-progress>
          <span class="reader-progress-fill" data-reader-progress-fill></span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<main class="page reader-page">
  <section class="detail">
    <% if @story_links.any? %>
      <div class="story-flow" data-reader-flow data-focus-scene-id="<%= @focus_scene_id %>">
        <% @story_links.each do |link| %>
          <% branches = @branches_by_scene_id[link.scene_id] %>
          <% show_branch_menu = branches.present? || current_user.present? %>
          <% menu_classes = ["scene-branch-menu"] %>
          <% menu_classes << "focus-only-menu" unless branches.present? %>
          <article id="scene-<%= link.scene_id %>" data-scene-id="<%= link.scene_id %>" class="scene <%= "focus" if link.scene_id == @focus_scene_id %>">
            <%= sanitize(link.scene.text, tags: %w[p strong h1 h2 ruby rt]) %>
            <% if show_branch_menu %>
              <details class="<%= menu_classes.join(" ") %>" data-scene-branch-menu>
                <summary class="scene-branch-menu-toggle" aria-label="シーンメニューを開く">
                </summary>
                <div class="scene-branch-menu-popover">
                  <% branches.each do |branch| %>
                    <%= link_to "分岐: #{branch.plot.title}", reader_scene_path(branch.plot_id, branch.next_scene_id), class: "scene-branch-menu-item" %>
                  <% end %>
                  <% if current_user.present? %>
                    <%= link_to "分岐を追加", fork_plot_scene_path(link), data: { turbo_method: :post }, class: "scene-branch-menu-item" %>
                  <% end %>
                </div>
              </details>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p>まだストーリーがありません。最初の文章を追加しましょう。</p>
      </div>
    <% end %>
  </section>

</main>

<script>
  (function() {
    const initReader = () => {
      const flow = document.querySelector("[data-reader-flow]");
      const progress = document.querySelector("[data-reader-progress]");
      if (!flow || !progress) return;
      if (flow.dataset.readerBound === "true") return;
      flow.dataset.readerBound = "true";

      const fill = progress.querySelector("[data-reader-progress-fill]");
      const focusSceneId = flow.dataset.focusSceneId;

      const updateProgress = () => {
        const flowTop = flow.getBoundingClientRect().top + window.scrollY;
        const flowHeight = flow.offsetHeight;
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const maxScroll = flowTop + flowHeight - viewportHeight;
        if (maxScroll <= flowTop) {
          fill.style.width = "100%";
          return;
        }
        const progressValue = (window.scrollY - flowTop) / (maxScroll - flowTop);
        const clamped = Math.max(0, Math.min(1, progressValue));
        fill.style.width = `${Math.round(clamped * 100)}%`;
      };

      updateProgress();
      window.addEventListener("scroll", updateProgress, { passive: true });
      window.addEventListener("resize", updateProgress);

      const setFocusScene = scene => {
        const currentFocus = flow.querySelector("article.scene.focus");
        if (currentFocus === scene) return;

        if (currentFocus) {
          currentFocus.classList.remove("focus");
        }

        scene.classList.add("focus");
        flow.dataset.focusSceneId = scene.dataset.sceneId || "";

        flow.querySelectorAll("details.scene-branch-menu[open]").forEach(menu => {
          if (!scene.contains(menu)) {
            menu.removeAttribute("open");
          }
        });
      };

      flow.addEventListener("click", event => {
        if (event.target.closest("a, button, summary, input, textarea, select, label")) return;

        const scene = event.target.closest("article.scene[data-scene-id]");
        if (!scene || !flow.contains(scene)) return;

        setFocusScene(scene);
      });

      if (focusSceneId) {
        const focusPanel = document.getElementById(`scene-${focusSceneId}`);
        if (focusPanel) {
          requestAnimationFrame(() => {
            focusPanel.scrollIntoView({ behavior: "smooth", block: "start" });
          });
        }
      }
    };

    document.addEventListener("DOMContentLoaded", initReader);
    document.addEventListener("turbo:load", initReader);
  })();
</script>
